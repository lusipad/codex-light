{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Light",
  "version": "0.2.0",
  "identifier": "com.codex.native.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Light",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "8dddee38-dad1-57eb-b04f-85cc566678c1"
      }
    },
    "resources": {
      "../src/themes/THIRD-PARTY-NOTICES": "licenses/themes/THIRD-PARTY-NOTICES",
      "../src/themes/SHIKI-THEMES-LICENSE": "licenses/themes/SHIKI-THEMES-LICENSE",
      "../src/themes/GITHUB-LICENSE": "licenses/themes/GITHUB-LICENSE",
      "../src/themes/DRACULA-LICENSE": "licenses/themes/DRACULA-LICENSE",
      "../src/themes/SOURCES.md": "licenses/themes/SOURCES.md"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
